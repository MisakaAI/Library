# Copy to: /etc/pi-web/pi-web.env
# Recommended permissions: chmod 600
# Recommended owner: the same Unix user that runs pi-web.service

# Outbound HTTP(S) proxy used by Pi Web for server-side model/API requests.
HTTP_PROXY='http://127.0.0.1:7890'
HTTPS_PROXY='http://127.0.0.1:7890'
NO_PROXY='localhost,127.0.0.1,::1'

# Generate a strong password, for example:
#   openssl rand -hex 32
# Pi Web Basic Auth username is always: pi
PI_WEB_PASSWORD='REPLACE_WITH_A_LONG_RANDOM_PASSWORD'

# External reverse-proxy / Cloudflare hostname(s), comma-separated, exact names.
# Example:
PI_WEB_ALLOWED_HOSTS='pi.example.com'

# Pi Web local listening port.
PORT='30141'

# IMPORTANT:
# Run `command -v pi-web` as the Unix account that installed it and paste the
# absolute result here. This avoids PATH problems under systemd.
PI_WEB_BIN='/usr/local/bin/pi-web'

# Optional: explicitly point at the existing pi agent data directory.
# Usually unnecessary when the systemd service runs as the same Unix user.
# PI_CODING_AGENT_DIR='/home/YOUR_USER/.pi/agent'
